<%- include('partials/header') %>

<main class="container py-5">
    <h2 class="gold-text">Dashboard: <%= user.role %> View</h2>

    <% if (user.role === 'Admin') { %>
        <section class="admin-stats row g-3 mb-5">
            <div class="col-md-4"><div class="card bg-surface p-3 border-gold"><h4>Total Platform Revenue</h4><p>R150,000</p></div></div>
            <div class="col-md-4"><div class="card bg-surface p-3"><h4>Pending Approvals</h4><p>5 Events</p></div></div>
            <div class="col-md-4"><div class="card bg-surface p-3"><h4>Total Users</h4><p>1,200</p></div></div>
        </section>

    <% } else if (user.role === 'Merchant') { %>
        <section class="merchant-stats mb-5">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="text-white">My Hosted Events</h3>
                <a href="/admin/manage" class="btn btn-gold">Create New Event</a>
            </div>
            <div class="card bg-surface border-secondary">
                <table class="table table-dark mb-0">
                    <thead>
                        <tr>
                            <th>Event</th>
                            <th>Status</th>
                            <th>Tickets Sold</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Jonoefen LIVE</td>
                            <td><span class="badge bg-warning text-dark">Pending Admin Approval</span></td>
                            <td>0/100</td>
                            <td><button class="btn btn-sm btn-outline-light">Edit</button></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

    <% } else { %>
        <h3 class="text-white">My Bookings</h3>
        <div class="card bg-surface border-secondary">
            </div>
    <% } %>
</main>

<%- include('partials/footer') %>