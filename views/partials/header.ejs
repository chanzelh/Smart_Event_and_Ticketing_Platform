<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EventPro | Smart Ticketing</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="d-flex flex-column min-vh-100 bg-dark text-light">
    <nav class="navbar navbar-expand-lg border-bottom border-secondary py-2">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="/">
                <img src="/images/tckt_logo.png" alt="TCKT Logo" height="45" class="me-2 rounded">
                <span class="luxe-brand text-white">Event</span><span class="gold-text">Pro</span>
            </a>
            
            <button class="navbar-toggler border-gold" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link text-white-50" href="/">Events</a></li>
                    <li class="nav-item"><a class="nav-link text-white-50" href="/contact">Contact</a></li>
                </ul>
                <div class="d-flex align-items-center">
                    <a href="/dashboard" class="btn btn-outline-light me-3">Dashboard</a>

                    <% if (locals.user) { %>
                        <span class="text-white-50 small d-none d-lg-inline">
                            Logged in as <strong class="gold-text"><%= user.role %></strong>
                        </span>
                        <a href="/auth/logout" class="btn btn-sm btn-outline-secondary ms-3">Logout</a>
                    <% } else { %>
                        <a href="/auth" class="btn btn-gold">Login / Register</a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>