<%- include('partials/header') %>

<main class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="text-cyan fw-bold mb-0">Dashboard</h1>
            <p class="text-white-50">Welcome back, <%= user.fullName %> (<%= user.role %>)</p>
        </div>
        <% if (user.role === 'Admin' || user.role === 'Merchant') { %>
            <div class="d-flex gap-2">
                <a href="/admin/manage" class="btn btn-purple-luxe px-4">
                    <i class="bi bi-plus-circle me-2"></i>Manage Events
                </a>
            </div>
        <% } %>
    </div>

    <% if (user.role === 'Admin' || user.role === 'Merchant') { %>
        
        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="card bg-surface border-secondary p-4 shadow-sm h-100">
                    <small class="text-white-50 text-uppercase fw-bold">Total Events</small>
                    <h2 class="display-5 text-white mb-0">
                        <%= typeof totalEvents !== 'undefined' ? totalEvents : 0 %>
                    </h2>
                    <div class="progress mt-3" style="height: 4px; background: #333;">
                        <div class="progress-bar bg-cyan" style="width: 70%"></div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-surface border-secondary p-4 shadow-sm h-100">
                    <small class="text-white-50 text-uppercase fw-bold">Tickets Sold</small>
                    <h2 class="display-5 text-white mb-0">
                        <%= typeof totalBookings !== 'undefined' ? totalBookings : 0 %>
                    </h2>
                    <div class="progress mt-3" style="height: 4px; background: #333;">
                        <div class="progress-bar bg-purple-luxe" style="width: 50%"></div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-surface border-secondary p-4 shadow-sm h-100">
                    <small class="text-white-50 text-uppercase fw-bold">Total Revenue</small>
                    <h2 class="display-5 text-cyan mb-0">
                        R<%= (typeof totalRevenue !== 'undefined' ? totalRevenue : 0).toLocaleString() %>
                    </h2>
                    <div class="progress mt-3" style="height: 4px; background: #333;">
                        <div class="progress-bar bg-cyan" style="width: 85%"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card bg-surface border-secondary p-4 shadow mb-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="h4 text-white mb-0">Recent Transactions</h3>
                <span class="badge rounded-pill bg-dark border border-secondary text-white-50">Live Analytics</span>
            </div>
            
            <% if (bookings && bookings.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0">
                        <thead>
                            <tr class="text-white-50 small text-uppercase">
                                <th>Customer</th>
                                <th>Event</th>
                                <th class="text-center">Qty</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% bookings.forEach(booking => { %>
                                <tr class="border-bottom border-secondary">
                                    <td>
                                        <div class="fw-bold"><%= booking.user?.fullName || 'Guest' %></div>
                                        <small class="text-white-50"><%= booking.user?.email || 'N/A' %></small>
                                    </td>
                                    <td class="text-cyan"><%= booking.event?.title || 'Unknown Event' %></td>
                                    <td class="text-center"><%= booking.quantity %></td>
                                    <td class="fw-bold">R<%= (booking.totalPrice || 0).toFixed(2) %></td>
                                    <td>
                                        <span class="badge bg-success-subtle text-success px-3">
                                            <%= booking.bookingStatus %>
                                        </span>
                                    </td>
                                    <td><small class="text-white-50"><%= new Date(booking.createdAt).toLocaleDateString() %></small></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="text-center py-5">
                    <i class="bi bi-receipt text-secondary display-4"></i>
                    <p class="text-white-50 mt-3">No bookings recorded yet.</p>
                </div>
            <% } %>
        </div>

    <% } else { %>
        <div class="card bg-surface border-secondary p-4 shadow">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="text-white mb-0">Your Past Bookings</h3>
                <a href="/" class="btn btn-outline-cyan btn-sm">Browse More Events</a>
            </div>

            <% if (bookings && bookings.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0">
                        <thead>
                            <tr class="text-white-50 small text-uppercase">
                                <th>Event</th>
                                <th>Date</th>
                                <th class="text-center">Qty</th>
                                <th>Total Paid</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% bookings.forEach(booking => { %>
                                <tr class="border-bottom border-secondary">
                                    <td>
                                        <div class="fw-bold text-cyan"><%= booking.event?.title || 'Event Removed' %></div>
                                        <small class="text-white-50"><%= booking.event?.venueName || 'N/A' %></small>
                                    </td>
                                    <td>
                                        <small><%= booking.event?.eventDateTime ? new Date(booking.event.eventDateTime).toDateString() : 'N/A' %></small>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-dark border border-secondary"><%= booking.quantity %></span>
                                    </td>
                                    <td class="fw-bold">R<%= (booking.totalPrice || 0).toFixed(2) %></td>
                                    <td>
                                        <span class="badge bg-success-subtle text-success px-3">
                                            <%= booking.bookingStatus %>
                                        </span>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="text-center py-5">
                    <i class="bi bi-ticket-perforated text-secondary display-4"></i>
                    <p class="text-white-50 mt-3">You haven't booked any events yet.</p>
                    <a href="/" class="btn btn-purple-luxe mt-2 px-4">Find Your First Event</a>
                </div>
            <% } %>
        </div>
    <% } %>
</main>

<style>
    /* Theme Accents */
    .text-cyan { color: #00f2ff !important; }
    .bg-cyan { background-color: #00f2ff !important; }
    .bg-surface { background-color: #1a1a1a !important; }
    .bg-purple-luxe { background-color: #8a2be2 !important; }
    
    .btn-purple-luxe {
        background-color: #8a2be2;
        color: white;
        border: none;
        transition: all 0.3s ease;
    }
    .btn-purple-luxe:hover {
        background-color: #7a1fd1;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(138, 43, 226, 0.3);
        color: white;
    }

    .btn-outline-cyan {
        color: #00f2ff;
        border: 1px solid #00f2ff;
    }
    .btn-outline-cyan:hover {
        background-color: #00f2ff;
        color: #121212;
    }

    /* Table & Status UI */
    .table-hover tbody tr:hover {
        background-color: rgba(0, 242, 255, 0.05) !important;
    }
    
    .bg-success-subtle { background-color: rgba(25, 135, 84, 0.15) !important; }
    
    .badge {
        font-weight: 500;
        letter-spacing: 0.5px;
    }

    .progress-bar { transition: width 1s ease-in-out; }
</style>

<%- include('partials/footer') %>