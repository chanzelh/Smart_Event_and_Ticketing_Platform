<%- include('partials/header') %>

<div class="container d-flex flex-column align-items-center py-5" style="min-height: 70vh;">
    
    <div class="text-center mb-5">
        <div class="display-1 text-cyan mb-2">
            <i class="bi bi-check-circle-fill"></i>
        </div>
        <h1 class="text-cyan fw-bold">Booking Confirmed!</h1>
        <p class="text-white-50">You have secured <%= ticket.quantity %> ticket(s). Your digital tickets are ready below.</p>
    </div>

    <div class="tickets-container w-100" style="max-width: 700px;">
        <% for(let i = 1; i <= ticket.quantity; i++) { %>
            <div class="ticket-visual mb-5">
                <div class="card bg-surface border-cyan-dim p-4 rounded-4 shadow-lg position-relative overflow-hidden">
                    <div class="row align-items-center">
                        <div class="col-md-8 border-end border-secondary border-dashed">
                            <div class="d-flex justify-content-between align-items-start">
                                <h1 class="display-6 fw-bold text-white mb-4">Tckt.</h1>
                                <span class="badge rounded-pill bg-purple-luxe">Ticket <%= i %> of <%= ticket.quantity %></span>
                            </div>
                            
                            <h2 class="h3 text-cyan fw-bold"><%= ticket.eventName %></h2>
                            
                            <p class="mb-1"><small class="text-white-50">Attendee:</small> <span class="text-white"><%= ticket.userName %></span></p>
                            <p class="mb-1"><small class="text-white-50">Date:</small> <span class="text-white"><%= ticket.eventDate %></span></p>
                            <p class="mb-0"><small class="text-white-50">Order ID:</small> <span class="text-cyan"><%= ticket.orderId %>-<%= i %></span></p>
                        </div>

                        <div class="col-md-4 text-center">
                            <div class="bg-white p-2 d-inline-block rounded-3 mb-2 shadow-cyan">
                                <img src="https://api.qrserver.com/v1/create-qr-code/?size=100x100&data=<%= ticket.orderId %>-<%= i %>" alt="QR Code" width="100">
                            </div>
                            <p class="small text-white-50 mb-0">SCAN TO VERIFY</p>
                        </div>
                    </div>
                    
                    <div class="punch-hole left"></div>
                    <div class="punch-hole right"></div>
                </div>
            </div>
        <% } %>
    </div>

    <div class="text-center mt-4">
        <a href="/downloads/ticket" class="btn btn-purple-luxe px-5 me-3 shadow-sm">
            <i class="bi bi-file-earmark-pdf"></i> Download PDF Ticket
        </a>
        <a href="/" class="btn btn-outline-cyan px-4">Back to Events</a>
    </div>
</div>

<style>
    .text-cyan { color: #00f2ff !important; }
    .border-cyan-dim { border: 1px solid rgba(0, 242, 255, 0.3) !important; }
    .bg-purple-luxe { background-color: #8a2be2 !important; }
    .btn-outline-cyan {
        color: #00f2ff;
        border: 1px solid #00f2ff;
    }
    .btn-outline-cyan:hover {
        background-color: #00f2ff;
        color: #121212;
    }
    
    .btn-purple-luxe {
        background-color: #8a2be2;
        color: white;
        border: none;
    }
    .btn-purple-luxe:hover {
        background-color: #7a1fd1;
        color: white;
    }

    .bg-surface { background-color: #1a1a1a !important; }
    .ticket-visual {
        background: #1a1a1a;
        border-radius: 20px;
        border: 1px dashed rgba(255, 255, 255, 0.1);
    }
    .border-dashed { border-style: dashed !important; }
    .punch-hole {
        position: absolute;
        top: 50%;
        width: 30px;
        height: 30px;
        background: #121212;
        border-radius: 50%;
        transform: translateY(-50%);
    }
    .punch-hole.left { left: -15px; }
    .punch-hole.right { right: -15px; }
    .shadow-cyan { box-shadow: 0 0 15px rgba(0, 242, 255, 0.2); }
</style>

<%- include('partials/footer') %>