<%- include('../partials/header') %>

<main class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold gold-text">Event Management</h2>
        <button class="btn btn-gold" data-bs-toggle="modal" data-bs-target="#createEventModal">
            <i class="bi bi-plus-circle"></i> Create New Event
        </button>
    </div>

    <div class="card bg-surface border-secondary shadow">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0">
                <thead>
                    <tr class="border-bottom border-secondary">
                        <th>Event Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Capacity</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Jonoefen LIVE at work</td>
                        <td>Concert</td>
                        <td>R250</td>
                        <td>45/50</td>
                        <td>
                            <button class="btn btn-sm btn-outline-info me-2">Edit</button>
                            <button class="btn btn-sm btn-outline-danger">Delete</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</main>

<div class="modal fade" id="createEventModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-surface border-secondary text-white">
            <div class="modal-header border-secondary">
                <h5 class="modal-title gold-text">Add New Event</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/admin/events" method="POST">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Event Title</label>
                        <input type="text" name="title" class="form-control" required>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Category</label>
                            <select name="category" class="form-select">
                                <option value="Concert">Concert</option>
                                <option value="Conference">Conference</option>
                                <option value="Workshop">Workshop</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Ticket Price (R)</label>
                            <input type="number" name="price" class="form-control" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Total Capacity</label>
                        <input type="number" name="capacity" class="form-control" required>
                    </div>
                    <div class="mb-3">
    <label class="form-label">Venue Name</label>
    <input type="text" name="venue" class="form-control bg-surface text-white" placeholder="e.g. 123 Kalk Street" required>
</div>

<div class="mb-3">
    <label class="form-label">Event Date & Time</label>
    <input type="datetime-local" name="date" class="form-control bg-surface text-white" required>
</div>

<div class="mb-3">
    <label class="form-label">Event Description</label>
    <textarea name="description" class="form-control bg-surface text-white" rows="4" placeholder="Describe the event experience..." required></textarea>
</div>

<div class="mb-3">
    <label class="form-label">Event Artwork (Image URL)</label>
    <input type="text" name="image" class="form-control bg-surface text-white" placeholder="Link to event image">
    <small class="text-white-50">Note: Event will require Admin approval before appearing on the Home Page.</small>
</div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-gold">Save Event</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>