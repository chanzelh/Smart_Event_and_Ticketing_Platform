<%- include('partials/header') %>

<section class="hero-section position-relative overflow-hidden">
    <div class="container-fluid p-0">
        <div class="row g-0">
            <div class="col-12 featured-event-bg" style="background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('/images/featured-bg.jpg') center/cover no-repeat; height: 500px;">
                <div class="container h-100 d-flex align-items-center">
                    <div class="hero-content">
                        <span class="badge bg-gold text-dark mb-2 fw-bold">FEATURED EVENT</span>
                        <h1 class="display-3 fw-bold text-white mb-3">Jonoefen LIVE at work</h1>
                        <p class="lead text-white-50 mb-4">
                            <i class="bi bi-geo-alt gold-text"></i> 123 Kalk Street
                            <span class="mx-2">|</span> 
                            <i class="bi bi-calendar-event gold-text"></i> Sat, 09 May 2026
                        </p>
                        <a href="/events/featured" class="btn btn-gold btn-lg">View Details <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="filter-bar py-4 sticky-top bg-dark border-bottom border-secondary">
    <div class="container">
        <form action="/events/search" method="GET" class="row g-2">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-surface border-secondary text-white-50"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control bg-surface border-secondary text-white" placeholder="Search for events...">
                </div>
            </div>
            <div class="col-md-3">
                <select name="category" class="form-select bg-surface border-secondary text-white">
                    <option value="">All Categories</option>
                    <option value="Concert">Music & Concerts</option>
                    <option value="Conference">Corporate Conferences</option>
                    <option value="Workshop">Workshops</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="availability" class="form-select bg-surface border-secondary text-white">
                    <option value="all">Availability</option>
                    <option value="available">Tickets Available</option>
                    <option value="sold-out">Sold Out</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-gold w-100">Apply Filters</button>
            </div>
        </form>
    </div>
</section>

<main class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Upcoming Shows and Events</h2>
        <a href="/events" class="text-gold text-decoration-none small">View All Events <i class="bi bi-arrow-right"></i></a>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        <div class="col">
            <div class="card h-100 bg-surface border-secondary event-card">
                <img src="/images/event-placeholder.jpeg" class="card-img-top" alt="Event Image">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <small class="gold-text fw-bold text-uppercase">Music</small>
                        <small class="text-white-50">R250 / Person</small>
                    </div>
                    <h5 class="card-title text-white">Example Concert Name</h5>
                    <p class="card-text text-white-50 small">Limited tickets available for this exclusive venue.</p>
                </div>
                <div class="card-footer bg-transparent border-top border-secondary">
                    <a href="/events/id" class="btn btn-outline-light w-100">Get Tickets</a>
                </div>
            </div>
        </div>
        </div>
</main>

<%- include('partials/footer') %>