<%- include('../partials/header') %>

<main class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold gold-text">Event Management</h2>

        <button class="btn btn-gold" data-bs-toggle="modal" data-bs-target="#createEventModal">
            <i class="bi bi-plus-circle"></i> Create New Event
        </button>
    </div>

    <div class="card bg-surface border-secondary shadow">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0">
                <thead>
                    <tr class="border-bottom border-secondary">
                        <th>Event Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Capacity</th>
                        <th>Available</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    <% if (typeof events !== 'undefined' && events.length > 0) { %>
                        <% events.forEach(event => { %>
                            <tr>
                                <td><%= event.title %></td>
                                <td><%= event.category %></td>
                                <td>R<%= event.ticketPrice %></td>
                                <td><%= event.totalCapacity %></td>
                                <td><%= event.availableTickets %></td>
                                <td><%= event.status %></td>
                                <td><%= new Date(event.eventDateTime).toLocaleString() %></td>
                                <td>
                                    <a href="/admin/edit/<%= event._id %>" class="btn btn-sm btn-outline-info me-2">
                                        Edit
                                    </a>

                                    <form action="/admin/delete/<%= event._id %>" method="POST" style="display:inline;">
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Are you sure you want to delete this event?')">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="8" class="text-center text-white-50 py-4">
                                No events found.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</main>

<!-- Create Event Modal -->
<div class="modal fade" id="createEventModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-surface border-secondary text-white">
            <div class="modal-header border-secondary">
                <h5 class="modal-title gold-text">Add New Event</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <form action="/admin/create" method="POST">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Event Title</label>
                        <input type="text" name="title" class="form-control" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Event Description</label>
                        <textarea name="description" class="form-control bg-surface text-white" rows="4"
                            placeholder="Describe the event experience..." required></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Category</label>
                            <select name="category" class="form-select" required>
                                <option value="Concert">Concert</option>
                                <option value="Conference">Conference</option>
                                <option value="Workshop">Workshop</option>
                                <option value="Sports">Sports</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Ticket Price (R)</label>
                            <input type="number" name="ticketPrice" class="form-control" min="0" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Total Capacity</label>
                        <input type="number" name="totalCapacity" class="form-control" min="1" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Venue Name</label>
                        <input type="text" name="venueName" class="form-control bg-surface text-white"
                            placeholder="e.g. 123 Kalk Street" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Event Date & Time</label>
                        <input type="datetime-local" name="eventDateTime" class="form-control bg-surface text-white" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Event Artwork (Image URL)</label>
                        <input type="text" name="artworkUrl" class="form-control bg-surface text-white"
                            placeholder="Link to event image">
                    </div>

                    <small class="text-white-50">
                        Note: Merchant-created events require admin approval before appearing on the Home Page.
                    </small>
                </div>

                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit" class="btn btn-gold">
                        Save Event
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Event Modal -->
<% if (typeof eventToEdit !== 'undefined' && eventToEdit) { %>
    <div class="modal fade" id="editEventModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content bg-surface border-secondary text-white">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title gold-text">Edit Event</h5>
                    <a href="/admin/manage" class="btn-close btn-close-white"></a>
                </div>

                <form action="/admin/edit/<%= eventToEdit._id %>" method="POST">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Event Title</label>
                            <input type="text" name="title" class="form-control" value="<%= eventToEdit.title %>" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Event Description</label>
                            <textarea name="description" class="form-control bg-surface text-white" rows="4" required><%= eventToEdit.description %></textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Category</label>
                                <select name="category" class="form-select" required>
                                    <option value="Concert" <%= eventToEdit.category === 'Concert' ? 'selected' : '' %>>Concert</option>
                                    <option value="Conference" <%= eventToEdit.category === 'Conference' ? 'selected' : '' %>>Conference</option>
                                    <option value="Workshop" <%= eventToEdit.category === 'Workshop' ? 'selected' : '' %>>Workshop</option>
                                    <option value="Sports" <%= eventToEdit.category === 'Sports' ? 'selected' : '' %>>Sports</option>
                                    <option value="Other" <%= eventToEdit.category === 'Other' ? 'selected' : '' %>>Other</option>
                                </select>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Ticket Price (R)</label>
                                <input type="number" name="ticketPrice" class="form-control" min="0" value="<%= eventToEdit.ticketPrice %>" required>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Total Capacity</label>
                            <input type="number" name="totalCapacity" class="form-control" min="1" value="<%= eventToEdit.totalCapacity %>" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Venue Name</label>
                            <input type="text" name="venueName" class="form-control bg-surface text-white" value="<%= eventToEdit.venueName %>" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Event Date & Time</label>
                            <input 
                                type="datetime-local" 
                                name="eventDateTime" 
                                class="form-control bg-surface text-white"
                                value="<%= new Date(eventToEdit.eventDateTime).toISOString().slice(0, 16) %>"
                                required
                            >
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Event Artwork (Image URL)</label>
                            <input type="text" name="artworkUrl" class="form-control bg-surface text-white" value="<%= eventToEdit.artworkUrl || '' %>">
                        </div>

                        <% if (user && user.role === 'Admin') { %>
                            <div class="mb-3">
                                <label class="form-label">Status</label>
                                <select name="status" class="form-select">
                                    <option value="Pending" <%= eventToEdit.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                                    <option value="Approved" <%= eventToEdit.status === 'Approved' ? 'selected' : '' %>>Approved</option>
                                    <option value="Rejected" <%= eventToEdit.status === 'Rejected' ? 'selected' : '' %>>Rejected</option>
                                </select>
                            </div>
                        <% } %>
                    </div>

                    <div class="modal-footer border-secondary">
                        <a href="/admin/manage" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-gold">Update Event</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
<% } %>

<%- include('../partials/footer') %>

<% if (typeof eventToEdit !== 'undefined' && eventToEdit) { %>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const editModalElement = document.getElementById('editEventModal');

            if (editModalElement && typeof bootstrap !== 'undefined') {
                const editModal = new bootstrap.Modal(editModalElement);
                editModal.show();
            }
        });
    </script>
<% } %>